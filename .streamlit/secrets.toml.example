# Copy this file to:  .streamlit/secrets.toml   (LOCAL USE ONLY)
# IMPORTANT: secrets.toml is gitignored — never commit real keys.
# For the hosted app, put the SAME keys in Streamlit Cloud:
#   App -> Settings -> Secrets -> "Create secrets file"
#
# Values are lowercase keys. Uses OpenRouter by default, but base_url can be
# any OpenAI-compatible endpoint (vLLM, Groq, Together, ...).

base_url = "https://openrouter.ai/api/v1"
api_key = "sk-or-your-openrouter-key"
chat_model = "openai/gpt-4o-mini"
embed_model = "openai/text-embedding-3-small"
top_k = 5